########################################
#  C / C++ build artifacts (CMake)    #
########################################
# Top-level build directory
/build/

# Generated by CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Compiled objects & libraries
*.o
*.obj
*.lo
*.la
*.a
*.so
*.dylib
*.dll

# Executables / app bundles
*.exe
*.out
*.app

########################################
#  Python artifacts                   #
########################################
# Byte-code & caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Packaging / dist
dist/
build/     # <- Python’s build/, different from C/C++ /build; adjust if you use one or the other
*.egg-info/

# Virtual-envs
venv/
.env/
.venv/

########################################
#  Simulation outputs                 #
########################################
/results.csv
/results.png

########################################
#  Tooling & IDE metadata             #
########################################
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

########################################
#  Logs & coverage                    #
########################################
*.log
.coverage
htmlcov/

########################################
#  OS cruft                           #
########################################
.DS_Store
Thumbs.db

